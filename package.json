{
  "name": "temp-email-worker",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test:unit": "node --test test/unit.test.js test/ui-syntax.test.js",
    "test:integration": "npm run build && node --test test/integration.test.js",
    "test": "npm run test:unit && npm run test:integration",
    "check": "npm test",
    "predeploy": "node scripts/predeploy-check.mjs && npm run check",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "postal-mime": "^2.4.2"
  },
  "devDependencies": {
    "wrangler": "^4.72.0"
  }
}
