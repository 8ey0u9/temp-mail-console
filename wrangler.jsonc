{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "temp-email-worker",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  // 启用 Cloudflare Free 套餐内置可观测日志（每天 0.5 GB、保留 7 天）
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/auth.html",
      "/console.html",
      "/api/*",
      "/admin/*",
      "/healthz"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "temp-email-db",
      // 一键部署向导会自动创建 D1 并回填 UUID；本地手动部署请执行 npx wrangler d1 create 填入
      "database_id": "",
      "migrations_dir": "migrations"
    }
  ],
  // Cloudflare Free 免费边缘限流绑定：保护登录与首次初始化免遭暴力枚举
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "triggers": {
    // 每小时执行一次，按控制台系统设置清理历史过期数据
    "crons": ["0 * * * *"]
  }
}
